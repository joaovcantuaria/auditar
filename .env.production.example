# =============================================================================
# TEMPLATE de variaveis de ambiente de PRODUCAO (DEMO / homologacao) — Auditar
# =============================================================================
# Copie para .env.production e preencha, OU cadastre estas variaveis direto no
# painel do Render (API) e do Vercel (frontend). NAO comite valores reais.
# Os comentarios indicam DE ONDE tirar cada valor. Veja DEPLOY.md.
# =============================================================================

# --- Ambiente ---------------------------------------------------------------
NODE_ENV=production
# A API le env.API_PORT. No Render a porta padrao exposta e 10000.
API_PORT=10000
# URL publica DESTA API (Render). Ex.: https://auditar-api.onrender.com
API_URL=https://SEU-SERVICO-API.onrender.com
# URL do frontend (Vercel). Ex.: https://auditar.vercel.app
WEB_URL=https://SEU-PROJETO.vercel.app

# --- Banco de dados: Neon ----------------------------------------------------
# Neon -> Dashboard -> Connection string (inclua ?sslmode=require).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/NOME_DB?sslmode=require

# --- Redis: Upstash ----------------------------------------------------------
# Upstash -> Database -> "Connect" -> copie a URL rediss:// e derive os campos.
# Formato: rediss://default:<SENHA>@<HOST>:<PORTA>
REDIS_URL=rediss://default:SENHA@SEU-HOST.upstash.io:6379
REDIS_HOST=SEU-HOST.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=SENHA_DO_UPSTASH
# Upstash exige TLS (rediss://). Mantenha true em producao.
REDIS_TLS=true

# --- Storage S3-compatible: Cloudflare R2 ------------------------------------
# R2 -> Overview mostra o endpoint https://<ACCOUNTID>.r2.cloudflarestorage.com
# Informe SOMENTE o host (sem https://); a lib usa host+port+useSSL.
MINIO_ENDPOINT=SEU-ACCOUNTID.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_USE_SSL=true
# Obrigatorio para R2 (presigned URLs). Use exatamente "auto".
MINIO_REGION=auto
# R2 -> Manage R2 API Tokens -> Access Key ID / Secret Access Key
MINIO_ROOT_USER=SUA_R2_ACCESS_KEY_ID
MINIO_ROOT_PASSWORD=SUA_R2_SECRET_ACCESS_KEY
# Nomes dos buckets criados no R2.
MINIO_BUCKET_PROCESSOS=auditar-processos
MINIO_BUCKET_RELATORIOS=auditar-relatorios

# --- JWT / Cripto ------------------------------------------------------------
# Gere um segredo forte (32+ chars): openssl rand -base64 48
JWT_SECRET=GERE_UM_SEGREDO_COM_32_OU_MAIS_CARACTERES
JWT_EXPIRES_IN=1h
JWT_LONG_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- SMTP: Resend ------------------------------------------------------------
# Resend -> API Keys -> crie uma chave (re_...). Via SMTP o usuario e "resend".
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_SUA_API_KEY_DO_RESEND
SMTP_FROM_NAME=Auditar
# E-mail de um dominio verificado no Resend. Para TESTE: onboarding@resend.dev
SMTP_FROM_ADDRESS=nao-responder@seudominio.com.br

# --- Feature flags -----------------------------------------------------------
FEATURE_SMS_ENABLED=false
FEATURE_PUSH_ENABLED=false

# --- CORS --------------------------------------------------------------------
# CSV de origens permitidas. Use a(s) URL(s) do Vercel (sem barra no final).
CORS_ORIGINS=https://SEU-PROJETO.vercel.app

# --- Rate limit / Sessao -----------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SERVER_SESSION_TIMEOUT_MIN=60
CITIZEN_SESSION_TIMEOUT_MIN=30
MAX_ADMINS=3

# =============================================================================
# FRONTEND (Vercel) — cadastrar no projeto Vercel, NAO no Render
# =============================================================================
# URL publica da API no Render + sufixo /api/v1 (o axios/socket usam esta var).
VITE_API_URL=https://SEU-SERVICO-API.onrender.com/api/v1
